def wait_candidates(api, org_id, device_id, seconds=65):
    deadline = time.time() + seconds
    last = []
    while time.time() < deadline:
        try:
            _, data = api.request(
                "GET",
                f"/api/v1/edge/devices/{urllib.parse.quote(device_id)}/discovery/candidates",
                query={"organization_id": org_id},
            )
            last = data.get("candidates") or []
            if last:
                return last
        except Exception:
            pass
        time.sleep(3)
    return last


