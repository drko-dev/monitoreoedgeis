    try:
        return int(v)
    except Exception:
        return None


def edge_identity(binary, env, repo):
    p = run_cmd([str(binary), "identity"], env=env, cwd=repo)
    if p.returncode != 0:
        raise RuntimeError(p.stdout.strip() or "No se pudo resolver la identidad Edge.")
    print(p.stdout.strip())
    for line in p.stdout.splitlines():
        if line.startswith("edge_id:"):
            return line.split(":", 1)[1].strip()
    return None


def saas_check(binary, env, repo):
    p = run_cmd([str(binary), "saas", "check"], env=env, cwd=repo)
    return p.returncode == 0, (p.stdout or "").strip()


def pgrep_edge():
    p = run_cmd(["pgrep", "-f", "[g]eocam-edge run"])
    if p.returncode != 0:
        return []
    out = []
    for x in p.stdout.split():
        try:
            out.append(int(x))
        except ValueError:
            pass
    return out


def stop_edge():
    pids = pgrep_edge()
    if not pids:
        print("OK: no había geocam-edge run activo.")
        return
    print("Deteniendo Edge activo:", ", ".join(map(str, pids)))
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    deadline = time.time() + 8
    while time.time() < deadline:
        alive = [pid for pid in pids if _alive(pid)]
        if not alive:
            print("OK: Edge detenido.")
            return
        time.sleep(0.4)
    for pid in pids:
        if _alive(pid):
            os.kill(pid, signal.SIGKILL)
    print("WARN: fue necesario terminar un proceso Edge por SIGKILL.")


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def start_edge(binary, env, repo, log_path, data_dir):
    stop_edge()
    log_path.parent.mkdir(parents=True, exist_ok=True)
    logf = open(log_path, "ab", buffering=0)
    p = subprocess.Popen(
        [str(binary), "run"],
        cwd=repo,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=logf,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    (data_dir / "run.pid").write_text(str(p.pid) + "\n")
    print(f"OK: Edge iniciado en background, PID={p.pid}")
    print(f"Log: {log_path}")
    return p.pid


def local_status(timeout=3):
    req = urllib.request.Request("http://127.0.0.1:8091/status", headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode("utf-8"))
    except Exception:
        return None


def wait_status(seconds=25):
    deadline = time.time() + seconds
    while time.time() < deadline:
        s = local_status()
        if s:
            return s
        time.sleep(1)
    raise RuntimeError("El Edge arrancó pero /status no respondió en 127.0.0.1:8091.")


def choose_from_list(title, items, label_fn, id_fn=lambda x: x.get("id"), preferred=None):
    if not items:
        return None
    if preferred is not None:
        for item in items:
            if str(id_fn(item)) == str(preferred):
                print(f"OK: {title}: {label_fn(item)} [preferencia persistida]")
                return item
    if len(items) == 1:
        print(f"OK: {title}: {label_fn(items[0])}")
        return items[0]
    print(f"\n{title}:")
    for idx, item in enumerate(items, 1):
        print(f"  {idx}) {label_fn(item)}")
    while True:
        raw = input("Elegí número: ").strip()
        if raw.isdigit() and 1 <= int(raw) <= len(items):
            return items[int(raw) - 1]
        print("Opción inválida.")


def resolve_org_site(api, profile, hints):
    orgs = profile.get("organizations") or []
    user = profile.get("user") or {}
    direct_org = _to_int(user.get("organization_id"))
    preferred_org = direct_org or hints.get("org_id") or _to_int(profile.get("default_organization_id"))
    org = choose_from_list(
        "Organización",
        orgs,
        lambda x: f"{x.get('name')} (id={x.get('id')})",
        preferred=preferred_org,
    )
    if not org:
        raise RuntimeError("No hay organizaciones operativas disponibles para este usuario.")
    org_id = int(org["id"])

    _, data = api.request("GET", "/api/sites", query={"organization_id": org_id})
    sites = [s for s in (data.get("sites") or []) if s.get("active", True)]
    site = choose_from_list(
        "Sitio",
        sites,
        lambda x: f"{x.get('name')} (id={x.get('id')})",
        preferred=hints.get("site_id"),
    )
    site_id = int(site["id"]) if site else None
    if site_id is None:
        print("WARN: no hay sitio activo; el Gateway quedará sin site.")
    return org_id, site_id


def ensure_enrollment(api, profile, binary, env, repo, data_dir, org_id, site_id):
    creds_path = data_dir / "credentials.json"
    if creds_path.exists():
        ok, msg = saas_check(binary, env, repo)
        if ok:
            print("OK: credencial Edge existente aceptada por SaaS.")
            return
        print("WARN: la credencial local existe pero SaaS la rechaza/no valida:")
        print(msg)
        backup = creds_path.with_name(f"credentials.json.bak.{int(time.time())}")
        shutil.move(str(creds_path), str(backup))
        print(f"Backup de credencial inválida: {backup}")

    name = f"{socket.gethostname()} Gateway"
    payload = {
        "name": name,
        "organization_id": org_id,
        "site_id": site_id,
    }
    print("Creando enrollment de Gateway en SaaS...")
    _, data = api.request("POST", "/api/v1/gateway/enrollments", payload)
    token = data.get("enrollment_token")
    if not token:
        raise RuntimeError("SaaS no devolvió enrollment_token.")
    print("OK: token de un solo uso generado (no se muestra ni se guarda).")

    p = run_cmd([str(binary), "enroll"], env=env, cwd=repo, input_text=token + "\n")
    token = None
    if p.returncode != 0:
        raise RuntimeError("Enrollment Edge falló: " + (p.stdout or "").strip())
    print((p.stdout or "").strip() or "OK: Edge enrolado.")

    ok, msg = saas_check(binary, env, repo)
    if not ok:
        raise RuntimeError("El enrollment terminó pero saas check falló:\n" + msg)
    print(msg)


