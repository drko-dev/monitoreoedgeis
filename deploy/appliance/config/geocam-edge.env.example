# GEO CAM Edge — appliance configuration (EnvironmentFile for systemd).
#
# Installed to /etc/geocam-edge/geocam-edge.env on first install and never
# overwritten by later installs/updates. Contains NO secrets:
# GEOCAM_ENROLLMENT_TOKEN is deliberately not settable here — the `enroll`
# CLI subcommand reads it from stdin or a one-shot environment variable at
# enrollment time only (see cmd/geocam-edge/main.go resolveEnrollmentToken),
# never from a file that would leave it sitting on disk in plaintext.
#
# Every variable below is read directly by internal/config.Load(); defaults
# and validation ranges shown are the actual values in that code, not
# aspirational ones. Uncomment a line to override its default.
#
# A bare install of this file runs the MEDIA-LESS profile: ONVIF discovery and
# inventory, health, heartbeat, control and OTA, plus the RTSP subsystem — but
# NO frames are decoded or uploaded, because GEOCAM_VIDEO_PIPELINE_ENABLED is
# false. That is deliberate and it is not the commercial Gateway. Camera-target
# provisioning is implemented/tested locally by Hito Z G1; real cameras, DVR/NVR
# and the physical pilot remain NOT_VALIDATED. To run a specific product start
# from one of the ready-made profile files instead:
#
#   geocam-edge.env.gateway.example    cloud  + media path, Cloud runs YOLO
#   geocam-edge.env.hybrid.example     local motion gating, Cloud runs YOLO
#   geocam-edge.env.fulledge.example   local YOLO (Python Vision Worker)
#
# See docs/product/COMMERCIAL_MODES.md for the capability matrix, the
# readiness of each mode, and the known gaps.

# --- Core -------------------------------------------------------------
# GEOCAM_SAAS_URL=https://your-tenant.example.com
# GEOCAM_EDGE_ID=                       # normally left unset: generated once and persisted to
                                         # $GEOCAM_DATA_DIR/identity.json on first run
# GEOCAM_PROCESSING_MODE=cloud          # cloud|hybrid|edge — default: cloud.
                                         # This selects WHERE inference runs; it does NOT
                                         # enable the local media path. All three modes are
                                         # implemented (hybrid since Hito J, edge since
                                         # Hito K). For the effective running profile read
                                         # /status's "profile" field, not this value:
                                         #   cloud  + GEOCAM_VIDEO_PIPELINE_ENABLED=true -> gateway
                                         #   hybrid + ...=true                           -> hybrid
                                         #   edge   + ...=true                           -> full-edge
                                         #   any mode with ...=false                     -> gateway-no-media
# GEOCAM_LOG_LEVEL=info                 # debug|info|warn|error — default: info. Logs go to
                                         # stdout only (journald captures them); there is no
                                         # separate file-logging path to configure.
# GEOCAM_DATA_DIR=/var/lib/geocam-edge  # identity.json, credentials.json, offline buffer.
                                         # NEVER delete this directory to "reset" the appliance —
                                         # see docs/deployment/appliance.md.
# GEOCAM_HEALTH_ADDR=127.0.0.1:8091     # local-only health HTTP surface (/healthz /readyz /status)

# --- SaaS transport -----------------------------------------------------
# GEOCAM_SAAS_TIMEOUT=10s                #
# GEOCAM_ALLOW_INSECURE_HTTP=false       # allow http:// (not https://) SaaS URLs — dev only
# GEOCAM_HEARTBEAT_INTERVAL=30s          # bounds: 5s-5m
# GEOCAM_HEARTBEAT_AUTH_FAILURE_INTERVAL= # bounds: 100ms-30m; default: the heartbeat
                                         # module's own 5m. This is the slow re-check poll
                                         # used after the SaaS rejects the credential with
                                         # 401/403, and therefore also the worst-case delay
                                         # before the Edge clears its DEGRADED state once an
                                         # operator re-enables the device.

# --- OTA release verification (Hito T) -----------------------------------
# REQUIRED before any upgrade can be applied. Path to the Ed25519 public key
# that signs SHA256SUMS for a release; it is hex or raw bytes in PEM or bare
# form. It is deliberately supplied out-of-band and never downloaded, so the
# artifact channel cannot vouch for itself. It must be readable by root: both
# geocam-edge.service (to stage/validate) and
# geocam-edge-ota-updater.service (to verify before activating) read it via
# this EnvironmentFile. If it is unset or unreadable, verification fails
# closed and every candidate release is rejected — that is the intended
# behaviour, not a misconfiguration to work around.
# GEOCAM_OTA_PUBLIC_KEY_FILE=/etc/geocam-edge/ota-signing-key.pub

# --- LAN discovery (ONVIF/WS-Discovery) ---------------------------------
# GEOCAM_DISCOVERY_ENABLED=true
# GEOCAM_DISCOVERY_INTERVAL=5m           # bounds: 1m-24h
# GEOCAM_DISCOVERY_TIMEOUT=4s            # bounds: 1s-30s
# GEOCAM_DISCOVERY_INTERFACES=           # comma-separated; default: auto-detect private interfaces

# --- Camera connectivity / RTSP -----------------------------------------
# GEOCAM_CONNECTIVITY_ENABLED=true
# GEOCAM_STREAM_ROLE=sub                 # sub|main — default: sub
# GEOCAM_STREAM_TIMEOUT=5s               # bounds: 1s-60s

# --- Video pipeline (ffmpeg subprocess) ---------------------------------
# GEOCAM_VIDEO_PIPELINE_ENABLED=false    # default OFF
# GEOCAM_VIDEO_TARGET_FPS=5              # bounds: 0.1-30
# GEOCAM_VIDEO_OUTPUT_WIDTH=640          # must be 0 (disabled, paired with height=0) or even, <=1920
# GEOCAM_VIDEO_OUTPUT_HEIGHT=360         # must be 0 (disabled, paired with width=0) or even, <=1080
# GEOCAM_VIDEO_RINGBUFFER_SIZE=30        # bounds: 1-300
# GEOCAM_VIDEO_QUEUE_DEPTH=64            # bounds: 4-512
# GEOCAM_VIDEO_DECODE_QUEUE_DEPTH=4      # bounds: 1-16
# GEOCAM_VIDEO_MAX_CONCURRENT_PIPELINES=4 # bounds: 1-16
# GEOCAM_VIDEO_FFMPEG_PATH=ffmpeg        # When this package ships a static ffmpeg, install.sh
                                          # already points the service at it deterministically
                                          # (/opt/geocam-edge/current/ffmpeg) via the systemd unit —
                                          # no need to set this for that case. Uncomment only to
                                          # override with a different ffmpeg binary.
# GEOCAM_VIDEO_DECODE_TIMEOUT=10s        # bounds: 1s-60s

# --- Cloud offline buffer -------------------------------------------------
# These have NO production default in the code (see internal/config.go
# comments on CloudBufferMaxBytes/CloudBufferMaxFrames): buffering only
# activates once BOTH are set to a positive value. Leaving them unset keeps
# the pre-buffer behavior (drop frames on a failed Cloud push). This file
# intentionally does not suggest numbers — that policy decision is still
# open upstream in the code, not something this appliance packaging should
# invent.
# GEOCAM_CLOUD_BUFFER_MAX_BYTES=
# GEOCAM_CLOUD_BUFFER_MAX_FRAMES=
# GEOCAM_CLOUD_BUFFER_MAX_AGE=0          # 0 = no age-based eviction (safe default, unlike the two above)

# --- Cloud bandwidth control ----------------------------------------------
# GEOCAM_CLOUD_JPEG_QUALITY=85           # bounds: 1-100
# GEOCAM_CLOUD_MAX_BYTES_PER_SEC=0       # 0 = unlimited (default). Software 1.0 intentionally
                                          # defines no universal production cap; configure one
                                          # per deployment when required.
# GEOCAM_CLOUD_BURST_BYTES=0             # 0 = automatic burst sizing when the byte limiter is
                                          # active; positive = explicit byte burst. It is not
                                          # an independent unlimited switch.
# GEOCAM_CLOUD_MAX_FPS=0                 # 0 = unlimited (default). Configure a cap per deployment
                                          # when required; no universal 1.0 FPS value is claimed.

# --- Hybrid local gating (Milestone J) ------------------------------------
# Meaningless unless GEOCAM_PROCESSING_MODE=hybrid AND the video pipeline is
# enabled. A block counts as "changed" when its average luma differs from the
# previous frame by more than the threshold; a frame is a candidate when the
# changed fraction of evaluated blocks reaches the minimum area. Pure Go, no
# model — hybrid never runs local inference.
# GEOCAM_VIDEO_HYBRID_MOTION_THRESHOLD=8 # luma units, bounds: 0-255
# GEOCAM_VIDEO_HYBRID_MIN_CHANGED_AREA=0.05 # fraction, bounds: 0-1. A value of 0 is
                                          # accepted and makes EVERY frame a candidate.
# GEOCAM_VIDEO_HYBRID_BLOCK_SIZE=16      # px, bounds: 4-128
# GEOCAM_VIDEO_HYBRID_ROI=               # ";"-separated x_min,y_min,x_max,y_max in
                                          # normalized 0-1 coords; empty = whole frame
# GEOCAM_VIDEO_HYBRID_IDLE_FPS=0         # bounds: 0-30; 0 (default) DISABLES adaptive
                                          # idle sampling. Must stay below TARGET_FPS.
# GEOCAM_VIDEO_HYBRID_IDLE_AFTER=5s      # only meaningful when IDLE_FPS > 0

# --- Full Edge local inference (Milestone K) ------------------------------
# Meaningless unless GEOCAM_PROCESSING_MODE=edge AND the video pipeline is
# enabled. Inference runs in an out-of-process Python Vision Worker; PyTorch is
# never embedded in the Go binary. See geocam-edge.env.fulledge.example.
#
# GEOCAM_EDGE_YOLO_WORKER_CMD has NO default: inventing an interpreter path
# would silently paper over a missing installation. Empty means "not
# configured" and reports NOT_READY / worker_not_configured rather than
# guessing. NOTE: the appliance release ships the worker's sources under
# vision-worker/ (and install.sh derives the script path for you), but not a
# Python runtime — this interpreter must be provisioned on the appliance and
# verified with scripts/check-vision-runtime.sh. See
# docs/product/COMMERCIAL_MODES.md §3.
# GEOCAM_EDGE_YOLO_WORKER_CMD=
# GEOCAM_EDGE_YOLO_WORKER_ARGS=          # extra argv, before the agent's own flags
# GEOCAM_EDGE_YOLO_MODELS_DIR=/var/lib/geocam-edge/models
                                          # defaults to $GEOCAM_DATA_DIR/models, deliberately
                                          # outside the versioned release tree so an agent
                                          # update never destroys installed weights
# GEOCAM_EDGE_YOLO_DEVICE=cpu            # cpu|cuda|auto. "cuda" is a REQUEST: on a host
                                          # without CUDA, both the Go side and the worker fall
                                          # back to CPU with an operator-visible warning. Read
                                          # the WORKER-confirmed device from
                                          # /status .vision.worker.device, not this value.
                                          # No GPU is validated by this repository.
# GEOCAM_EDGE_YOLO_SOCKET_PATH=/var/lib/geocam-edge/run/vision-worker.sock
                                          # the agent creates this directory. A Unix socket
                                          # path is capped at 104 bytes (macOS/BSD) / 108
                                          # (Linux); the default is far inside that.
# GEOCAM_EDGE_YOLO_IMGSZ=640             # bounds: 128-1920
# GEOCAM_EDGE_YOLO_PERSON_CONFIDENCE=0.5 # bounds: 0-1
# GEOCAM_EDGE_YOLO_VEHICLE_CONFIDENCE=0.5 # bounds: 0-1
# GEOCAM_EDGE_YOLO_NMS_IOU=0.45          # bounds: 0-1
# GEOCAM_EDGE_YOLO_START_TIMEOUT=30s     # bounds: 1s-5m. A cold torch + weights load that
                                          # exceeds the appliance's 30s /readyz budget makes
                                          # update.sh roll the release back.
# GEOCAM_EDGE_YOLO_INFER_TIMEOUT=5s      # bounds: 100ms-60s
#
# Note: there is no environment variable for the model FILENAMES. They default
# to yolo11s-pose.pt / yolo11n.pt and are settable only through remote
# configuration. Missing weights give the explicit "model_missing" state;
# nothing is auto-downloaded.

# --- Full Edge admission and resource guards ------------------------------
# GEOCAM_EDGE_MAX_CONCURRENT_INFERENCE=1 # bounds: 1-16. Matches the Router path's real
                                          # invariant of one worker goroutine per sink, and is
                                          # enforced as a non-blocking admission semaphore.
# GEOCAM_EDGE_INFERENCE_QUEUE_DEPTH=32   # bounds: 1-256. REPORTED FOR VISIBILITY ONLY — no
                                          # code enforces it. The real admission cap is
                                          # MAX_CONCURRENT_INFERENCE above.
# GEOCAM_EDGE_MIN_FREE_DISK_BYTES=104857600 # 100MB. Gates JPEG capture writes only —
                                          # it does NOT cover MP4 clips.
# GEOCAM_EDGE_MAX_MEMORY_PERCENT=0       # bounds: 0-100; 0 = disabled

# --- Local event sync backlog (Full Edge) ---------------------------------
# Unlike the Cloud frame buffer, these HAVE conservative defaults, because
# events must survive a SaaS outage. Overflow REFUSES the newest record and
# counts the drop; it never silently discards.
# GEOCAM_LOCAL_EVENT_BACKLOG_MAX_OPERATIONS=100
# GEOCAM_LOCAL_EVENT_BACKLOG_MAX_BYTES=536870912   # 512MiB
# GEOCAM_EDGE_MAX_CLIP_SIZE_BYTES=20971520         # 20MiB. Technical ceiling for one MP4
                                          # clip, enforced locally before an upload the SaaS
                                          # would reject anyway. NOT the SaaS-side JPEG limit.

# --- Known limitations this file used to be silent about ------------------
# 1. There is NO retention or eviction for Full Edge events or evidence, and
#    the free-disk gate above does not cover clips. Budget disk accordingly.
# 2. Real-camera / DVR/NVR / physical-pilot validation is still outstanding;
#    camera-target provisioning itself is implemented/tested locally (Hito Z G1).
# 3. With the video pipeline disabled, remote-config tuning is accepted and
#    ACKed to the SaaS while changing nothing (gap G4; fixed on the separate
#    Hito Z B4 branch and reconciled in final integration).
