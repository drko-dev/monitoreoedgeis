# GEO CAM Edge — HYBRID profile
#
# Copy to /etc/geocam-edge/geocam-edge.env (or merge into it) to run this
# appliance as the commercial HYBRID: the Gateway's local media path PLUS a
# local, model-free motion evaluator that lets only candidate frames through.
# ALL inference stays in the Cloud — hybrid runs no model.
#
# Effective profile on /status: "hybrid".
#
# See docs/product/COMMERCIAL_MODES.md §2 for the capability matrix and §3 for
# what has and has not been verified.
#
# READ THIS BEFORE QUOTING ANY SAVING: there is NO measured bandwidth saving.
# The only figure in this repository ("66.00%") is explicitly synthetic — an
# injected i%3==0 selector that never constructs a pipeline or a motion
# detector. Do not put a percentage in commercial material.

# --- Core ---------------------------------------------------------------
GEOCAM_PROCESSING_MODE=hybrid

# Required. With the pipeline disabled no MotionDetector is built, the mode is
# silently inert, and the agent will log a warning naming the real profile
# ("gateway-no-media"). Hybrid is not delivered by the mode string alone.
GEOCAM_VIDEO_PIPELINE_ENABLED=true

GEOCAM_SAAS_URL=https://your-tenant.example.com

# --- Everything the Gateway needs ---------------------------------------
# Hybrid is a superset of the Gateway media path: discovery, RTSP
# connectivity and the ffmpeg pipeline all apply unchanged. See
# geocam-edge.env.gateway.example for those settings and for the uplink caps.

# --- Local gating (this is what makes it Hybrid) -------------------------
# A block is "changed" when its average luma differs from the PREVIOUS FRAME by
# more than MOTION_THRESHOLD. A frame is a candidate when the changed fraction
# (of evaluated blocks) reaches MIN_CHANGED_AREA. Pure Go, no model.
GEOCAM_VIDEO_HYBRID_MOTION_THRESHOLD=8      # luma units, 0-255. Default 8.
GEOCAM_VIDEO_HYBRID_MIN_CHANGED_AREA=0.05   # fraction, 0-1. Default 0.05.
GEOCAM_VIDEO_HYBRID_BLOCK_SIZE=16           # px, 4-128. Default 16.

# Restrict evaluation to normalized (0..1) rectangles, ";"-separated
# "x_min,y_min,x_max,y_max". Empty = whole frame. Use this to ignore a road, a
# tree line, or a public footpath that would otherwise produce constant
# candidates.
# GEOCAM_VIDEO_HYBRID_ROI=

# --- Adaptive idle sampling (OPTIONAL, off by default) -------------------
# With IDLE_FPS>0 the sampler drops to that rate once IDLE_AFTER has passed
# with no candidate. Default 0 disables adaptation entirely, so a hybrid
# pipeline with this unset behaves exactly like Cloud mode's sampler — which
# is also why Cloud mode can no longer inherit it (defect D2).
# IDLE_FPS must stay BELOW TARGET_FPS; if TargetFPS is later lowered below it
# by remote config, adaptation switches off rather than exceed the ceiling.
# GEOCAM_VIDEO_HYBRID_IDLE_FPS=0            # 0-30, default 0 = disabled
# GEOCAM_VIDEO_HYBRID_IDLE_AFTER=5s         # only meaningful when IDLE_FPS>0

# --- Two configuration hazards ------------------------------------------
# 1. MIN_CHANGED_AREA=0 is accepted and makes EVERY evaluated frame a
#    candidate: hybrid then uploads as much as Cloud while still paying the
#    full local decode+diff cost, with no warning. Do not set 0.
# 2. Hybrid adds NO default byte-rate cap of its own. The three
#    GEOCAM_CLOUD_MAX_* knobs still default to 0 = unlimited; the candidate
#    filter is the only volume reduction, and it is unmeasured. See
#    geocam-edge.env.gateway.example for those knobs.

# --- OFF by default: the frame buffer -----------------------------------
# GEOCAM_CLOUD_BUFFER_MAX_BYTES/_MAX_FRAMES have no production default. With
# them unset, an unreachable SaaS means candidates are LOST, not queued — the
# edgebacklog carries Full Edge events only, there is no second recovery path
# for candidates. Set both to enable the disk spool.
# GEOCAM_CLOUD_BUFFER_MAX_BYTES=
# GEOCAM_CLOUD_BUFFER_MAX_FRAMES=

# --- OTA ----------------------------------------------------------------
# GEOCAM_OTA_PUBLIC_KEY_FILE=/etc/geocam-edge/ota-signing-key.pub
