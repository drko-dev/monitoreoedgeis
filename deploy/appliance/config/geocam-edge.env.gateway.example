# GEO CAM Edge — GATEWAY profile
#
# Copy to /etc/geocam-edge/geocam-edge.env (or merge into it) to run this
# appliance as the commercial GATEWAY: a lightweight local media path that
# decodes and samples every camera and uploads frames, with ALL inference left
# to the Cloud.
#
# Effective profile on /status: "gateway".
#
# See docs/product/COMMERCIAL_MODES.md §2 for the capability matrix and §3 for
# what has and has not been verified. This file sets only what differs from
# geocam-edge.env.example's defaults; that file documents every remaining
# variable.

# --- Core ---------------------------------------------------------------
# cloud mode = "no local YOLO", which is exactly what the Gateway is.
GEOCAM_PROCESSING_MODE=cloud

# THE defining knob. Without it the agent builds no media path at all and the
# Edge becomes discovery/health/control/OTA only ("gateway-no-media"): no
# ffmpeg decode, no sampling, and NO FRAMES EVER REACH THE CLOUD, so Cloud YOLO
# sees nothing. It defaults to false, so a stock install is NOT a Gateway.
GEOCAM_VIDEO_PIPELINE_ENABLED=true

# Required for heartbeat, enrollment, control, OTA and discovery-run claims.
# Any inference at all depends on this Edge being able to reach the SaaS.
GEOCAM_SAAS_URL=https://your-tenant.example.com

# --- Required for the media path ----------------------------------------
# ffmpeg must exist. The packaged appliance ships a static ffmpeg at
# /opt/geocam-edge/current/ffmpeg and install.sh points the unit at it
# automatically; set this only to override with a different binary.
# GEOCAM_VIDEO_FFMPEG_PATH=ffmpeg

# --- Discovery, inventory and the RTSP subsystem ------------------------
# Both default to true; listed because they are the Gateway's other functions.
GEOCAM_DISCOVERY_ENABLED=true
GEOCAM_CONNECTIVITY_ENABLED=true
# Which ONVIF profile's stream to connect to. Prefer the substream: decoders
# and the uplink are sized for it.
GEOCAM_STREAM_ROLE=sub
#
# BE PRECISE ABOUT WHAT THIS BUYS YOU TODAY: it constructs the RTSP manager and
# the decode that consumes its packets, but no production code path calls
# rtsp.Manager.SetTargets and discovery does not feed it, so the manager
# supervises ZERO cameras and /status omits "cameras". Per-camera RTSP
# connectivity is blocked by gap G1 in every profile — including this one.
# Discovery and inventory themselves work; the camera connection to them does
# not exist yet.

# --- Media path sizing --------------------------------------------------
# Every value below is the real default from internal/config and every one is
# a technical bound, not a commercial recommendation. Tune against a real
# measurement on the target hardware; docs/deployment/hardware.md records that
# no real multi-camera measurement exists.
# GEOCAM_VIDEO_TARGET_FPS=5                 # 0.1-30
# GEOCAM_VIDEO_OUTPUT_WIDTH=640             # both 0 disables resize, else both even
# GEOCAM_VIDEO_OUTPUT_HEIGHT=360
# GEOCAM_VIDEO_RINGBUFFER_SIZE=30           # 1-300
# GEOCAM_VIDEO_QUEUE_DEPTH=64               # 4-512
# GEOCAM_VIDEO_DECODE_QUEUE_DEPTH=4         # 1-16 (deliberately small)
# GEOCAM_VIDEO_MAX_CONCURRENT_PIPELINES=4   # 1-16 ffmpeg subprocesses — size this to the box
# GEOCAM_VIDEO_DECODE_TIMEOUT=10s           # 1s-60s

# --- Uplink control -----------------------------------------------------
# All three default to 0 = UNLIMITED, and with 0 no rate limiter is even
# constructed. The Gateway therefore has NO byte-rate cap out of the box: the
# only default bound is TARGET_FPS x frame size. Set these on a metered or
# shared uplink. The production values are an open decision upstream — this
# file deliberately proposes no number.
# GEOCAM_CLOUD_JPEG_QUALITY=85              # 1-100; not a throttle, a size knob
# GEOCAM_CLOUD_MAX_BYTES_PER_SEC=0          # 0 = unlimited
# GEOCAM_CLOUD_BURST_BYTES=0                # 0 = derive from the rate above
# GEOCAM_CLOUD_MAX_FPS=0                    # 0 = unlimited

# --- Offline behavior ---------------------------------------------------
# There is NO production default for the frame buffer: buffering activates
# only when BOTH values below are positive. Until then, a frame that cannot be
# uploaded is LOST (it is counted in cloud.frames_upload_failed, not queued).
# These two numbers are a business/retention decision this repository does not
# invent; leave commented to keep the documented drop-on-failure behavior.
# GEOCAM_CLOUD_BUFFER_MAX_BYTES=
# GEOCAM_CLOUD_BUFFER_MAX_FRAMES=
# GEOCAM_CLOUD_BUFFER_MAX_AGE=0             # 0 = no age-based eviction (safe default)

# --- OTA ----------------------------------------------------------------
# REQUIRED before any upgrade can be applied: verification fails closed without
# it. Supply the Ed25519 public key out of band.
# GEOCAM_OTA_PUBLIC_KEY_FILE=/etc/geocam-edge/ota-signing-key.pub

# --- Known gaps that affect this profile --------------------------------
# G1 (docs/product/COMMERCIAL_MODES.md §6): no production code path populates
# camera targets, so /status will omit "cameras" and heartbeats will carry an
# empty list. RTSP connectivity and camera health are implemented but not yet
# wired to any camera in production.
