# GEO CAM Edge — FULL EDGE profile
#
# Copy to /etc/geocam-edge/geocam-edge.env (or merge into it) to run this
# appliance as the commercial FULL EDGE: all inference happens locally, in an
# out-of-process PYTHON VISION WORKER. The Go agent never embeds PyTorch.
#
# Effective profile on /status: "full-edge".
#
# See docs/product/COMMERCIAL_MODES.md §2 for the capability matrix, §3 for
# readiness, §4 for the hardware posture and §5 for what runs locally.
#
# ======================================================================
# THE APPLIANCE PACKAGE DOES NOT INSTALL THE VISION WORKER.
#
# package.sh ships the Go binary, static ffmpeg, the systemd units, the scripts
# and the env example. It does NOT ship deploy/vision-worker/, does not install
# Python, does not create a virtualenv and does not fetch any model weights.
# GEOCAM_EDGE_YOLO_WORKER_CMD has no default on purpose: a guessed interpreter
# path would hide a missing installation.
#
# So before this profile can work at all you must provision, by hand:
#   1. Python 3 and the worker's requirements:
#        python3 -m venv /opt/geocam-edge/vision-venv
#        /opt/geocam-edge/vision-venv/bin/pip install -r deploy/vision-worker/requirements.txt
#   2. The worker script itself (deploy/vision-worker/worker.py, backend.py).
#   3. The YOLO weights under $GEOCAM_DATA_DIR/models (default names below).
#      Nothing is auto-downloaded; missing weights give the explicit
#      "model_missing" state, never a silent substitute.
#   4. GEOCAM_EDGE_YOLO_WORKER_CMD pointing at the interpreter.
# ======================================================================

# --- Core ---------------------------------------------------------------
GEOCAM_PROCESSING_MODE=edge

# Required. With the pipeline disabled no local-inference Sink is built, so
# edge mode performs no local inference at all and the agent logs a warning
# naming the real profile. (As of this branch that no longer pins /readyz to
# 503 forever, but it is still not Full Edge.)
GEOCAM_VIDEO_PIPELINE_ENABLED=true

GEOCAM_SAAS_URL=https://your-tenant.example.com

# --- The Vision Worker (REQUIRED, no default) ----------------------------
GEOCAM_EDGE_YOLO_WORKER_CMD=/opt/geocam-edge/vision-venv/bin/python
# Extra argv placed before the agent's own flags. Point at worker.py:
GEOCAM_EDGE_YOLO_WORKER_ARGS=/opt/geocam-edge/vision/worker.py

# The worker speaks newline-delimited JSON over a Unix socket. The agent now
# creates this socket's parent directory itself ($GEOCAM_DATA_DIR/run), which
# nothing else provisions.
# GEOCAM_EDGE_YOLO_SOCKET_PATH=/var/lib/geocam-edge/run/vision-worker.sock
# NOTE: a Unix socket path is capped at 104 bytes on macOS/BSD and 108 on Linux.
# The default is far inside that; a long custom path is not validated.

# --- Device selection: cpu | cuda | auto --------------------------------
# cuda, but verify before believing it:
#   - "cuda" is a REQUEST. On a host where torch reports no CUDA device, BOTH
#     the Go side (which probes /dev/nvidia0, /dev/nvhost-ctrl, nvidia-smi) and
#     the worker fall back to CPU, each with an operator-visible warning, and
#     the substitution is counted. There is no hard failure and no silent
#     success.
#   - Read the WORKER-CONFIRMED device, not the requested one:
#       curl -s localhost:8091/status | jq '.vision.worker | {device, device_requested}'
#     and each event records the device it actually used.
#   - No GPU has been validated by this repository, no board is certified, and
#     no deployment artefact grants /dev/nvidia* access: there is no
#     DeviceAllow, no SupplementaryGroups and no udev rule. CUDA is reachable
#     only because the unit deliberately does NOT set PrivateDevices=true,
#     which would mask the accelerator nodes. Do NOT add PrivateDevices=true.
GEOCAM_EDGE_YOLO_DEVICE=cpu

# --- Models -------------------------------------------------------------
# Defaults to $GEOCAM_DATA_DIR/models, deliberately outside the versioned
# release tree so an agent update never destroys installed weights.
# GEOCAM_EDGE_YOLO_MODELS_DIR=/var/lib/geocam-edge/models
# The default filenames are yolo11s-pose.pt and yolo11n.pt. There is no
# environment variable for the filenames — they are settable only through
# remote configuration.
# GEOCAM_EDGE_YOLO_IMGSZ=640                # 128-1920
# GEOCAM_EDGE_YOLO_PERSON_CONFIDENCE=0.5    # 0-1
# GEOCAM_EDGE_YOLO_VEHICLE_CONFIDENCE=0.5   # 0-1
# GEOCAM_EDGE_YOLO_NMS_IOU=0.45             # 0-1

# Model loading is slow. A cold torch + weights load that exceeds the
# appliance's 30-second /readyz budget makes update.sh roll the release back.
# Raise these only with a measurement.
# GEOCAM_EDGE_YOLO_START_TIMEOUT=30s        # 1s-5m
# GEOCAM_EDGE_YOLO_INFER_TIMEOUT=5s         # 100ms-60s

# --- Local inference admission and resource guards -----------------------
# MAX_CONCURRENT_INFERENCE matches the real invariant of the Router path
# (exactly one worker goroutine per sink) and is enforced as a non-blocking
# admission semaphore; drops are counted in queues.vision.drops.
# GEOCAM_EDGE_MAX_CONCURRENT_INFERENCE=1    # 1-16
# GEOCAM_EDGE_INFERENCE_QUEUE_DEPTH=32      # 1-256 — REPORTED FOR VISIBILITY
#                                           # ONLY, not enforced; max concurrent
#                                           # inference is the real admission cap.
GEOCAM_EDGE_MIN_FREE_DISK_BYTES=104857600   # 100MB; gates JPEG capture writes
# GEOCAM_EDGE_MAX_MEMORY_PERCENT=0          # 0 = disabled

# --- Local events, evidence and sync ------------------------------------
# Unlike the frame buffer, these HAVE conservative defaults because events must
# survive a SaaS outage. Overflow REFUSES the newest record and counts the
# drop; it never silently discards.
# GEOCAM_LOCAL_EVENT_BACKLOG_MAX_OPERATIONS=100
# GEOCAM_LOCAL_EVENT_BACKLOG_MAX_BYTES=536870912   # 512MiB
# Technical ceiling for one MP4 clip, applied locally before an upload the SaaS
# would reject anyway. NOT the same knob as the SaaS-side JPEG limit.
# GEOCAM_EDGE_MAX_CLIP_SIZE_BYTES=20971520         # 20MiB

# Evidence is written under $GEOCAM_DATA_DIR:
#   events/<uuid>.json, evidence/captures/<uuid>.jpg, evidence/clips/<event>.mp4
# There is NO retention or eviction for events or evidence on the Edge, and the
# free-disk gate above covers JPEG captures but NOT clips. Budget disk
# accordingly; storage retention is a separate slice.

# --- OTA ----------------------------------------------------------------
# GEOCAM_OTA_PUBLIC_KEY_FILE=/etc/geocam-edge/ota-signing-key.pub

# --- Not applicable -----------------------------------------------------
# The Cloud frame caps (GEOCAM_CLOUD_*) and the hybrid evaluator knobs
# (GEOCAM_VIDEO_HYBRID_*) are irrelevant here: full edge does not upload frames
# and uses real inference, not motion gating. Leave them alone.
