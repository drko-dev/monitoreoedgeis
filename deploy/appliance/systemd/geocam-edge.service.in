[Unit]
Description=GEO CAM Edge agent
Documentation=https://github.com/drko-dev/monitoreoedgeis/blob/main/docs/deployment/appliance.md
# No arbitrary sleeps: wait for a real network before starting so the SaaS
# heartbeat/enrollment client doesn't spend its first attempts against a
# link that isn't up yet.
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify (Hito Y/Y9): the agent implements sd_notify and sends READY=1
# once its modules have started, then WATCHDOG=1 while it is still able to
# answer its own /healthz. Type=simple could not express either, so systemd had
# no way to tell "still starting" from "started" and no way to detect a process
# that is running but no longer serving.
Type=notify
WorkingDirectory=@GEOCAM_DATA_DIR_PLACEHOLDER@
ExecStart=@GEOCAM_EXEC_PATH@ run
@GEOCAM_FFMPEG_ENV_LINE@
# Derived from the installed release (B2): the Full Edge vision worker's SCRIPT
# path. The interpreter is NOT set here -- the package ships no Python runtime --
# so GEOCAM_EDGE_YOLO_WORKER_CMD must be provisioned by the operator and checked
# with scripts/check-vision-runtime.sh. An operator override in EnvironmentFile
# below still wins (later systemd definitions override earlier ones).
@GEOCAM_VISION_ENV_LINE@
EnvironmentFile=@GEOCAM_ENV_FILE@
# Managed mode requires pre-existing identity and matching enrolled credentials;
# unlike first-run CLI bootstrap, the daemon must never create a replacement ID.
Environment=GEOCAM_SERVICE_MODE=true
User=@GEOCAM_SERVICE_USER@
Group=@GEOCAM_SERVICE_GROUP@

# Only the main process may send notifications. NOTIFY_SOCKET is not exported
# into the ffmpeg or vision-worker children, so they cannot complete startup or
# feed the watchdog on the agent's behalf.
NotifyAccess=main

# Startup is local work only: read identity/credentials from disk, recover the
# persisted backlog and cloud spool, bind the loopback health port. READY=1 is
# sent as soon as that health surface answers, so 30s is already generous, and a
# startup that never gets there should surface in half a minute rather than
# after the 90s default.
TimeoutStartSec=30

# Restart=on-failure covers a process that EXITS. It does not cover a process
# that is still running but wedged -- a deadlock, a stuck accept loop, a runtime
# gone bad -- which is exactly what the agent's own restart loops cannot see
# either, because the goroutine that would notice is part of the wedge.
#
# WatchdogSec=60 is the ceiling: the agent pings at a third of it (20s), so two
# consecutive missed checks are still tolerated before systemd intervenes. That
# margin is deliberate on an appliance that also runs ffmpeg decoders and a
# YOLO worker; a momentary stall under load must not kill a working Edge.
# 60s is also the longest a wedged agent can keep looking healthy, which is well
# inside the interval at which an operator would notice it is not reporting.
#
# A killed watchdog is a failure as far as systemd is concerned, so the
# StartLimit pair below bounds the recovery: at most five restarts per five
# minutes, after which the unit is left failed for an operator to inspect rather
# than restarting forever.
WatchdogSec=60

# The agent's own signal.NotifyContext(SIGINT, SIGTERM) in cmd/geocam-edge
# does an in-process graceful shutdown (see main.go) — systemd only needs to
# send the default TERM and give it time to unwind (module stop order,
# in-flight HTTP requests, buffer flush). The agent sends STOPPING=1 as soon as
# shutdown begins, which also cancels the watchdog timer, so this window is
# never raced by a watchdog kill. No SIGKILL escalation needed for the common
# case, hence the generous TimeoutStopSec.
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=on-failure
RestartSec=2
StartLimitIntervalSec=300
StartLimitBurst=5

# Hardening: least privilege beyond the dedicated non-root service account.
# NoNewPrivileges/ProtectSystem/ProtectHome are safe defaults for a Go
# process that only needs GEOCAM_DATA_DIR writable and outbound network
# access (SaaS HTTPS, LAN RTSP/ONVIF) plus a local loopback health port.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@GEOCAM_DATA_DIR_PLACEHOLDER@
PrivateTmp=true

# Hito S / S10: confirmed safe by audit, not guessed. Neither the agent's
# own networking nor its ffmpeg subprocess (software-only decode) needs
# any Linux capability -- see docs/security/least-privilege.md.
# A PrivateDevices directive was evaluated and deliberately NOT enabled here:
# Full Edge's vision worker (deploy/vision-worker/, internal/vision)
# supports GEOCAM_EDGE_YOLO_DEVICE=cuda (Hito K/K5), and the CUDA/PyTorch
# runtime it invokes needs host accelerator device nodes (/dev/nvidia*)
# even though no literal "/dev/nvidia" path appears in this repo's own
# source. Enabling that directive would mask those nodes and break that
# profile. This unit is shared by every processing mode (cloud/hybrid/
# edge), so it cannot assume CPU-only. See least-privilege.md for the
# full analysis and what a future profile-aware policy would need.
CapabilityBoundingSet=

# ffmpeg subprocess + RTSP/ONVIF discovery sockets: raise the file
# descriptor ceiling above the 1024 default rather than invent a number —
# this is a ceiling, not a claim about how many the agent actually opens at
# steady state.
LimitNOFILE=65536

# No secrets are ever printed by geocam-edge (see cmd/geocam-edge `config`/
# `identity` commands), and EnvironmentFile above holds no secrets either —
# GEOCAM_ENROLLMENT_TOKEN is meant to be supplied out-of-band to `geocam-edge
# enroll` (stdin or a one-shot env var), never persisted here. journald
# receives only stdout/stderr, which is the only logging surface the agent
# has (log/slog to stdout) — no parallel file-logging system to configure.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geocam-edge

[Install]
WantedBy=multi-user.target
