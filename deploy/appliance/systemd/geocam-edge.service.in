[Unit]
Description=GEO CAM Edge agent
Documentation=https://github.com/drko-dev/monitoreoedgeis/blob/main/docs/deployment/appliance.md
# No arbitrary sleeps: wait for a real network before starting so the SaaS
# heartbeat/enrollment client doesn't spend its first attempts against a
# link that isn't up yet.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@GEOCAM_DATA_DIR_PLACEHOLDER@
ExecStart=@GEOCAM_EXEC_PATH@ run
@GEOCAM_FFMPEG_ENV_LINE@
EnvironmentFile=@GEOCAM_ENV_FILE@
User=@GEOCAM_SERVICE_USER@
Group=@GEOCAM_SERVICE_GROUP@

# The agent's own signal.NotifyContext(SIGINT, SIGTERM) in cmd/geocam-edge
# does an in-process graceful shutdown (see main.go) — systemd only needs to
# send the default TERM and give it time to unwind (module stop order,
# in-flight HTTP requests, buffer flush). No SIGKILL escalation needed for
# the common case, hence the generous TimeoutStopSec.
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=on-failure
RestartSec=2
StartLimitIntervalSec=300
StartLimitBurst=5

# Hardening: least privilege beyond the dedicated non-root service account.
# NoNewPrivileges/ProtectSystem/ProtectHome are safe defaults for a Go
# process that only needs GEOCAM_DATA_DIR writable and outbound network
# access (SaaS HTTPS, LAN RTSP/ONVIF) plus a local loopback health port.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@GEOCAM_DATA_DIR_PLACEHOLDER@
PrivateTmp=true

# Hito S / S10: confirmed safe by audit, not guessed. The agent and its
# ffmpeg subprocess do plain TCP/HTTP networking and software-only video
# decode -- no VAAPI/V4L2/hardware device access anywhere in this repo
# (see docs/security/least-privilege.md), and thermal reads are plain file
# reads under /sys/class/thermal, unaffected by device-node restriction.
# An empty capability set and no /dev access are therefore safe: neither
# needs any Linux capability nor any physical device beyond the always-
# allowed pseudo-devices (null/zero/random, which PrivateDevices keeps).
CapabilityBoundingSet=
PrivateDevices=true

# ffmpeg subprocess + RTSP/ONVIF discovery sockets: raise the file
# descriptor ceiling above the 1024 default rather than invent a number —
# this is a ceiling, not a claim about how many the agent actually opens at
# steady state.
LimitNOFILE=65536

# No secrets are ever printed by geocam-edge (see cmd/geocam-edge `config`/
# `identity` commands), and EnvironmentFile above holds no secrets either —
# GEOCAM_ENROLLMENT_TOKEN is meant to be supplied out-of-band to `geocam-edge
# enroll` (stdin or a one-shot env var), never persisted here. journald
# receives only stdout/stderr, which is the only logging surface the agent
# has (log/slog to stdout) — no parallel file-logging system to configure.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geocam-edge

[Install]
WantedBy=multi-user.target
